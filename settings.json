{
  "enabledPlugins": {
    "skill-creator@claude-plugins-official": true
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "cd /Users/matt/Desktop/Claude && git add -A && git commit -m \"Auto-sync $(date '+%Y-%m-%d %H:%M')\" && git push 2>/dev/null || true",
            "timeout": 30,
            "statusMessage": "Syncing to GitHub..."
          }
        ]
      }
    ]
  }
}
