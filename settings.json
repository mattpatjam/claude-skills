{
  "enabledPlugins": {
    "skill-creator@claude-plugins-official": true
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "/Users/matt/Desktop/Claude/.claude/hooks/git-sync.sh /Users/matt/Desktop/Claude",
            "timeout": 60,
            "statusMessage": "Syncing to GitHub..."
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "/Users/matt/Desktop/Claude/.claude/hooks/project-tracker-reminder.sh"
          }
        ]
      }
    ]
  }
}
